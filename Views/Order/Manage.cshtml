@model IEnumerable<E_Commerce.Models.Order>
@{
    ViewData["Title"] = "Manage Orders";
    Layout = "_AdminLayout";
}

<h2><i class="bi bi-bag-check"></i> Manage Orders</h2>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Order #</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Status</th>
                <th>Payment</th>
                <th>Total</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model.OrderByDescending(o => o.CreatedAt))
            {
                <tr>
                    <td><code>@order.OrderNumber</code></td>
                    <td>@order.ShippingName</td>
                    <td>@order.CreatedAt.ToString("g")</td>
                    <td>
                        <span class="badge bg-@(order.Status == E_Commerce.Models.OrderStatus.Delivered ? "success" : 
                                                order.Status == E_Commerce.Models.OrderStatus.Cancelled ? "danger" : "warning")">
                            @order.Status
                        </span>
                    </td>
                    <td>
                        @if (order.PaymentStatus == E_Commerce.Models.PaymentStatus.Paid)
                        {
                            <span class="text-success"><i class="bi bi-check"></i></span>
                        }
                        else
                        {
                            <span class="text-warning">@order.PaymentStatus</span>
                        }
                    </td>
                    <td class="fw-bold">@order.TotalAmount.ToString("C")</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-primary">
                            <i class="bi bi-eye"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
