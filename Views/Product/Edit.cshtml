@model E_Commerce.Models.Product
@{
    ViewData["Title"] = "Edit Product";
    Layout = "_AdminLayout";
    var categories = ViewBag.Categories as IEnumerable<E_Commerce.Models.Category>;
    var variants = ViewBag.Variants as IEnumerable<E_Commerce.Models.ProductVariant> ?? Enumerable.Empty<E_Commerce.Models.ProductVariant>();
    var images = ViewBag.Images as IEnumerable<E_Commerce.Models.ProductImage> ?? Enumerable.Empty<E_Commerce.Models.ProductImage>();
}

<div class="row g-4">
    <!-- Product Details -->
    <div class="col-lg-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0"><i class="bi bi-pencil me-2"></i>Edit Product</h5>
            </div>
            <div class="card-body">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="row mb-3">
                        <div class="col-md-8">
                            <label class="form-label">Product Name *</label>
                            <input type="text" name="Name" value="@Model.Name" class="form-control" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">SKU</label>
                            <input type="text" name="SKU" value="@Model.SKU" class="form-control" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Brand *</label>
                            <input type="text" name="Brand" value="@Model.Brand" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Category *</label>
                            <select name="CategoryId" class="form-select" required>
                                @if (categories != null)
                                {
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat.Id" selected="@(cat.Id == Model.CategoryId)">@cat.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Price *</label>
                            <div class="input-group">
                                <input type="number" name="Price" value="@Model.Price" class="form-control" required min="0" step="1000" />
                                <span class="input-group-text">₫</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Discount Price</label>
                            <div class="input-group">
                                <input type="number" name="DiscountPrice" value="@Model.DiscountPrice" class="form-control" min="0" step="1000" />
                                <span class="input-group-text">₫</span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
                    </div>

                    <!-- Image Section -->
                    <div class="mb-3">
                        <label class="form-label">Main Image</label>
                        @if (!string.IsNullOrEmpty(Model.MainImageUrl))
                        {
                            <div class="mb-2">
                                <img src="@Model.MainImageUrl" alt="Current" class="img-thumbnail" style="max-height:100px" />
                            </div>
                        }
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        <small class="text-muted">Or enter URL:</small>
                        <input type="url" name="imageUrl" value="@Model.MainImageUrl" class="form-control mt-1" placeholder="https://..." />
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input type="checkbox" name="IsActive" value="true" checked="@Model.IsActive" class="form-check-input" />
                                <label class="form-check-label">Active</label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-check form-switch">
                                <input type="checkbox" name="IsFeatured" value="true" checked="@Model.IsFeatured" class="form-check-input" />
                                <label class="form-check-label">Featured</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Save Changes
                        </button>
                        <a asp-action="Manage" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Variants & Stock -->
    <div class="col-lg-4">
        <!-- Add Variant Form -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-success text-white py-3">
                <h6 class="mb-0"><i class="bi bi-plus-circle me-2"></i>Add Stock Variant</h6>
            </div>
            <div class="card-body">
                <form asp-action="AddVariant" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label class="form-label">Size</label>
                        <select name="Size" class="form-select">
                            <option value="">No Size</option>
                            <option value="36">36</option>
                            <option value="37">37</option>
                            <option value="38">38</option>
                            <option value="39">39</option>
                            <option value="40">40</option>
                            <option value="41">41</option>
                            <option value="42">42</option>
                            <option value="43">43</option>
                            <option value="44">44</option>
                            <option value="45">45</option>
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Color</label>
                        <input type="text" name="Color" class="form-control" placeholder="e.g. Black, White" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Stock Quantity *</label>
                        <input type="number" name="StockQuantity" class="form-control" required min="0" value="10" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Variant SKU</label>
                        <input type="text" name="VariantSKU" class="form-control" placeholder="e.g. @(Model.SKU)-40-BLK" />
                    </div>
                    <button type="submit" class="btn btn-success w-100">
                        <i class="bi bi-plus-lg me-1"></i>Add Variant
                    </button>
                </form>
            </div>
        </div>

        <!-- Existing Variants -->
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="mb-0"><i class="bi bi-boxes me-2"></i>Stock Variants</h6>
                <span class="badge bg-primary">@variants.Count()</span>
            </div>
            <div class="card-body p-0">
                @if (variants.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var variant in variants)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    @if (!string.IsNullOrEmpty(variant.Size))
                                    {
                                        <span class="badge bg-secondary me-1">Size @variant.Size</span>
                                    }
                                    @if (!string.IsNullOrEmpty(variant.Color))
                                    {
                                        <span class="badge bg-info me-1">@variant.Color</span>
                                    }
                                    <span class="fw-bold @(variant.StockQuantity == 0 ? "text-danger" : variant.StockQuantity <= 5 ? "text-warning" : "text-success")">
                                        @variant.StockQuantity in stock
                                    </span>
                                </div>
                                <form asp-action="DeleteVariant" asp-route-id="@variant.Id" asp-route-productId="@Model.Id" 
                                      method="post" onsubmit="return confirm('Delete this variant?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="bi bi-exclamation-triangle text-warning display-6"></i>
                        <p class="text-muted mb-0 mt-2">No variants yet</p>
                        <small class="text-muted">Add variants above to set stock</small>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
