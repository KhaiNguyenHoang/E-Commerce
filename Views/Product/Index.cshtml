@model IEnumerable<E_Commerce.Models.Product>
@{
    ViewData["Title"] = "Shop Products";
    var categories = ViewBag.Categories as IEnumerable<E_Commerce.Models.Category>;
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalItems = (int)(ViewBag.TotalItems ?? 0);
    var sortBy = ViewBag.SortBy as string;
    var currentCategoryId = (int?)ViewBag.CategoryId;
}

<!-- Page Header -->
<div class="bg-white border-bottom py-4 mb-4">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-1 bg-transparent p-0">
                        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="breadcrumb-item active">Shop</li>
                    </ol>
                </nav>
                <h1 class="h3 fw-bold mb-0">All Products</h1>
            </div>
            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                <span class="text-muted"><i class="bi bi-box-seam me-1"></i>@totalItems items found</span>
            </div>
        </div>
    </div>
</div>

<div class="container pb-5">
    <div class="row">
        <!-- Sidebar Filters -->
        <div class="col-lg-3 mb-4">
            <div class="card border-0 shadow-sm sticky-top" style="top: 90px; z-index: 10;">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-funnel me-2"></i>Filters</h5>
                </div>
                <div class="card-body">
                    <!-- Search -->
                    <div class="mb-4">
                        <form method="get" action="@Url.Action("Index")">
                            <input type="hidden" name="categoryId" value="@currentCategoryId" />
                            <div class="form-floating mb-2">
                                <input type="text" name="search" value="@ViewBag.Search" class="form-control" id="searchInput" placeholder="Search...">
                                <label for="searchInput">Search Products</label>
                            </div>
                            <div class="d-grid">
                                <button type="submit" class="btn btn-outline-primary btn-sm">Search</button>
                            </div>
                        </form>
                    </div>

                    <!-- Categories -->
                    <div class="mb-4">
                        <h6 class="fw-bold mb-3">Categories</h6>
                        <div class="list-group list-group-flush border rounded-3 overflow-hidden">
                            <a href="@Url.Action("Index", new { sortBy, search = ViewBag.Search })" 
                               class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(currentCategoryId == null ? "active bg-primary border-primary" : "")">
                                <span>All Products</span>
                                <i class="bi bi-chevron-right small opacity-75"></i>
                            </a>
                            @if (categories != null)
                            {
                                @foreach (var cat in categories)
                                {
                                    var isActive = currentCategoryId == cat.Id;
                                    <a href="@Url.Action("Index", new { categoryId = cat.Id, sortBy, search = ViewBag.Search })" 
                                       class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(isActive ? "active bg-primary border-primary" : "")">
                                        <span>@cat.Name</span>
                                        @if (isActive) { <i class="bi bi-check-circle-fill small"></i> }
                                    </a>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Product Grid -->
        <div class="col-lg-9">
            <!-- Sort & Toolbar -->
            <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded shadow-sm border">
                <div class="d-none d-md-block">
                    @if (ViewBag.Search != null)
                    {
                        <span>Search results for: <strong>"@ViewBag.Search"</strong></span>
                        <a href="@Url.Action("Index")" class="ms-2 text-decoration-none text-danger"><i class="bi bi-x-circle"></i> Clear</a>
                    }
                </div>
                <form method="get" class="d-flex align-items-center ms-auto">
                    <input type="hidden" name="categoryId" value="@currentCategoryId" />
                    <input type="hidden" name="search" value="@ViewBag.Search" />
                    <label class="me-2 text-muted small text-nowrap">Sort by:</label>
                    <select name="sortBy" class="form-select form-select-sm border-secondary" style="width: 160px;" onchange="this.form.submit()">
                        <option value="newest" selected="@(sortBy == "newest")">Newest Arrivals</option>
                        <option value="name" selected="@(sortBy == "name")">Name (A-Z)</option>
                        <option value="price_asc" selected="@(sortBy == "price_asc")">Price (Low to High)</option>
                        <option value="price_desc" selected="@(sortBy == "price_desc")">Price (High to Low)</option>
                    </select>
                </form>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <div class="mb-3 text-muted">
                        <i class="bi bi-search" style="font-size: 3rem;"></i>
                    </div>
                    <h4>No products found</h4>
                    <p class="text-muted">Try adjusting your search or filters.</p>
                    <a href="@Url.Action("Index")" class="btn btn-primary mt-2">Clear All Filters</a>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-md-3 g-4">
                    @foreach (var product in Model)
                    {
                        <div class="col">
                            <div class="card product-card h-100 border-0 shadow-sm">
                                <div class="position-relative overflow-hidden" style="height: 240px;">
                                    <a asp-action="Details" asp-route-id="@product.Id" class="d-block h-100">
                                        @if (!string.IsNullOrEmpty(product.MainImageUrl))
                                        {
                                            <img src="@product.MainImageUrl" class="card-img-top h-100" 
                                                 style="object-fit: cover;" alt="@product.Name" />
                                        }
                                        else
                                        {
                                            <div class="h-100 bg-secondary bg-opacity-10 d-flex align-items-center justify-content-center">
                                                <i class="bi bi-image text-muted fs-1"></i>
                                            </div>
                                        }
                                    </a>
                                    
                                    @if (product.IsFeatured)
                                    {
                                        <span class="badge-discount bg-warning text-dark"><i class="bi bi-star-fill me-1"></i>Featured</span>
                                    }
                                    
                                    <div class="quick-actions">
                                        <form asp-controller="Wishlist" asp-action="Add" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@product.Id" />
                                            <button type="submit" class="btn btn-light rounded-circle" data-bs-toggle="tooltip" title="Add to Wishlist">
                                                <i class="bi bi-heart"></i>
                                            </button>
                                        </form>
                                        <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-light rounded-circle" title="View Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </div>
                                </div>
                                
                                <div class="card-body">
                                    <div class="text-muted small mb-1">@product.Category?.Name</div>
                                    <h6 class="product-title mb-2">
                                        <a asp-action="Details" asp-route-id="@product.Id" class="text-decoration-none text-dark">
                                            @product.Name
                                        </a>
                                    </h6>
                                    <div class="d-flex align-items-center justify-content-between mt-3">
                                        <div class="price-display fs-5">@product.Price.ToString("C")</div>
                                        <form asp-controller="Cart" asp-action="Add" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="productId" value="@product.Id" />
                                            <input type="hidden" name="quantity" value="1" />
                                            <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3">
                                                <i class="bi bi-bag-plus me-1"></i> Add
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                
                <!-- Pagination -->
                @if (totalPages > 1)
                {
                    <nav class="mt-5 d-flex justify-content-center">
                        <ul class="pagination pagination-md shadow-sm">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link border-0" href="@Url.Action("Index", new { page = currentPage - 1, categoryId = currentCategoryId, search = ViewBag.Search, sortBy })">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                            
                            @for (int i = 1; i <= totalPages; i++)
                            {
                                if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link border-0" href="@Url.Action("Index", new { page = i, categoryId = currentCategoryId, search = ViewBag.Search, sortBy })">@i</a>
                                    </li>
                                }
                                else if (i == currentPage - 3 || i == currentPage + 3)
                                {
                                    <li class="page-item disabled"><span class="page-link border-0">...</span></li>
                                }
                            }
                            
                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link border-0" href="@Url.Action("Index", new { page = currentPage + 1, categoryId = currentCategoryId, search = ViewBag.Search, sortBy })">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        </div>
    </div>
</div>
