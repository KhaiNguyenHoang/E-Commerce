@model E_Commerce.Models.User
@{
    ViewData["Title"] = "My Account";
}

<h2><i class="bi bi-person-circle"></i> My Account</h2>

<div class="row">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model?.AvatarUrl))
                {
                    <img src="@Model.AvatarUrl" class="rounded-circle mb-3" width="120" height="120" style="object-fit: cover;" />
                }
                else
                {
                    <div class="bg-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 120px; height: 120px;">
                        <i class="bi bi-person text-white" style="font-size: 3rem;"></i>
                    </div>
                }
                <h4>@Model?.FullName</h4>
                <p class="text-muted">@Model?.Email</p>
                <span class="badge bg-info">@Model?.Role?.Name</span>
            </div>
        </div>
        
        <div class="list-group mt-3">
            <a asp-action="Edit" class="list-group-item list-group-item-action">
                <i class="bi bi-pencil"></i> Edit Profile
            </a>
            <a asp-action="ChangePassword" class="list-group-item list-group-item-action">
                <i class="bi bi-key"></i> Change Password
            </a>
            <a asp-action="Addresses" class="list-group-item list-group-item-action">
                <i class="bi bi-geo-alt"></i> Addresses
            </a>
            <a asp-controller="Order" asp-action="Index" class="list-group-item list-group-item-action">
                <i class="bi bi-bag"></i> My Orders
            </a>
        </div>
    </div>
    
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">Account Details</div>
            <div class="card-body">
                <table class="table table-borderless">
                    <tr>
                        <td class="text-muted" width="150">Full Name</td>
                        <td>@Model?.FullName</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Email</td>
                        <td>@Model?.Email</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Phone</td>
                        <td>@(Model?.PhoneNumber ?? "Not set")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Member Since</td>
                        <td>@Model?.CreatedAt.ToString("MMMM dd, yyyy")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Last Login</td>
                        <td>@(Model?.LastLoginAt?.ToString("g") ?? "Never")</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>
