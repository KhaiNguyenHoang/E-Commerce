@model IEnumerable<E_Commerce.Models.Address>
@{
    ViewData["Title"] = "My Addresses";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-geo-alt"></i> My Addresses</h2>
    <a asp-action="AddAddress" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Add Address
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No addresses saved yet.</div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var addr in Model)
        {
            <div class="col">
                <div class="card @(addr.IsDefault ? "border-primary" : "")">
                    @if (addr.IsDefault)
                    {
                        <div class="card-header bg-primary text-white">
                            <i class="bi bi-star-fill"></i> Default Address
                        </div>
                    }
                    <div class="card-body">
                        <h5>@addr.RecipientName</h5>
                        <p class="mb-1">@addr.StreetAddress</p>
                        <p class="mb-1">@addr.Ward, @addr.District</p>
                        <p class="mb-1">@addr.City, @addr.Country</p>
                        <p class="mb-0 text-muted"><i class="bi bi-telephone"></i> @addr.PhoneNumber</p>
                    </div>
                    <div class="card-footer bg-transparent">
                        <a asp-action="EditAddress" asp-route-id="@addr.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        @if (!addr.IsDefault)
                        {
                            <form asp-action="SetDefaultAddress" asp-route-id="@addr.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-success">
                                    <i class="bi bi-star"></i> Set Default
                                </button>
                            </form>
                        }
                        <form asp-action="DeleteAddress" asp-route-id="@addr.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this address?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
