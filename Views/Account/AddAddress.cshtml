@{
    ViewData["Title"] = "Add Address";
}

<h2><i class="bi bi-geo-alt"></i> Add Address</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }
                
                <form method="post">
                    @Html.AntiForgeryToken()
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Recipient Name *</label>
                            <input type="text" name="RecipientName" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Phone Number *</label>
                            <input type="tel" name="PhoneNumber" class="form-control" required />
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Street Address *</label>
                        <input type="text" name="StreetAddress" class="form-control" required />
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Ward</label>
                            <input type="text" name="Ward" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">District *</label>
                            <input type="text" name="District" class="form-control" required />
                        </div>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">City *</label>
                            <input type="text" name="City" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Country</label>
                            <input type="text" name="Country" value="Vietnam" class="form-control" />
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Postal Code</label>
                        <input type="text" name="PostalCode" class="form-control" />
                    </div>
                    
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success">Add Address</button>
                        <a asp-action="Addresses" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
