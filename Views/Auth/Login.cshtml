@{
    ViewData["Title"] = "Login";
}

<div class="row min-vh-75 align-items-center justify-content-center py-5">
    <div class="col-md-8 col-lg-6 col-xl-5">
        <div class="card border-0 shadow-lg overflow-hidden">
            <div class="row g-0">
                <!-- Left decoration (optional, or just top header) -->
                <div class="col-12">
                    <div class="bg-primary p-4 text-center text-white" 
                         style="background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);">
                        <i class="bi bi-shield-lock-fill" style="font-size: 3rem; opacity: 0.8;"></i>
                        <h2 class="fw-bold mt-2 text-white">Welcome Back</h2>
                        <p class="mb-0 text-white-50">Sign in to continue to ShoeStore</p>
                    </div>
                </div>
                
                <div class="col-12">
                    <div class="card-body p-4 p-md-5">
                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger d-flex align-items-center mb-4">
                                <i class="bi bi-exclamation-circle-fill me-2"></i>
                                <div>@ViewBag.Error</div>
                            </div>
                        }
                        
                        <form method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                            
                            <div class="form-floating mb-3">
                                <input type="email" name="email" class="form-control" id="emailInput" placeholder="name@example.com" required>
                                <label for="emailInput">Email address</label>
                            </div>
                            
                            <div class="form-floating mb-4">
                                <input type="password" name="password" class="form-control" id="passwordInput" placeholder="Password" required>
                                <label for="passwordInput">Password</label>
                            </div>

                            <div class="d-flex justify-content-end mb-4">
                                <a asp-action="ForgotPassword" class="text-decoration-none small">Forgot Password?</a>
                            </div>
                            
                            <div class="d-grid mb-4">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="bi bi-box-arrow-in-right"></i> Sign In
                                </button>
                            </div>
                            
                            <div class="text-center text-muted">
                                <p class="mb-0">
                                    Don't have an account? 
                                    <a asp-action="Register" class="text-decoration-none fw-bold">Sign up now</a>
                                </p>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="text-center mt-4">
            <small class="text-muted">
                <i class="bi bi-shield-check me-1"></i> Secure Login System
            </small>
        </div>
    </div>
</div>
