@model E_Commerce.Models.Category
@{
    ViewData["Title"] = "Edit Category";
}

<h2><i class="bi bi-pencil"></i> Edit Category</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }
                
                <form method="post">
                    @Html.AntiForgeryToken()
                    
                    <div class="mb-3">
                        <label class="form-label">Name *</label>
                        <input type="text" name="name" value="@Model.Name" class="form-control" required />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea name="description" class="form-control" rows="3">@Model.Description</textarea>
                    </div>
                    
                    <div class="form-check mb-3">
                        <input type="checkbox" name="isActive" value="true" checked="@Model.IsActive" class="form-check-input" />
                        <label class="form-check-label">Active</label>
                    </div>
                    
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
