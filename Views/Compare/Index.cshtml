@model IEnumerable<E_Commerce.Models.Product>
@{
    ViewData["Title"] = "Compare Products";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-columns-gap me-2"></i>Compare Products</h2>
        @if (Model.Any())
        {
            <form asp-action="Clear" method="post">
                <button type="submit" class="btn btn-outline-danger">
                    <i class="bi bi-x-lg"></i> Clear All
                </button>
            </form>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-columns-gap display-1 text-muted"></i>
            <h4 class="mt-3">No products to compare</h4>
            <p class="text-muted">Add products from the product page to compare them side by side</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary">
                Browse Products
            </a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered">
                <thead class="table-light">
                    <tr>
                        <th style="width:200px">Attribute</th>
                        @foreach (var product in Model)
                        {
                            <th class="text-center">
                                <form asp-action="Remove" asp-route-id="@product.Id" method="post" class="float-end">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-x"></i>
                                    </button>
                                </form>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="fw-bold">Image</td>
                        @foreach (var product in Model)
                        {
                            <td class="text-center">
                                <img src="@(product.MainImageUrl ?? "/images/placeholder.jpg")" 
                                     alt="@product.Name" class="img-fluid" style="max-height:150px" />
                            </td>
                        }
                    </tr>
                    <tr>
                        <td class="fw-bold">Name</td>
                        @foreach (var product in Model)
                        {
                            <td class="text-center">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">
                                    @product.Name
                                </a>
                            </td>
                        }
                    </tr>
                    <tr>
                        <td class="fw-bold">Brand</td>
                        @foreach (var product in Model)
                        {
                            <td class="text-center">@product.Brand</td>
                        }
                    </tr>
                    <tr>
                        <td class="fw-bold">Category</td>
                        @foreach (var product in Model)
                        {
                            <td class="text-center">@product.Category?.Name</td>
                        }
                    </tr>
                    <tr>
                        <td class="fw-bold">Price</td>
                        @foreach (var product in Model)
                        {
                            <td class="text-center">
                                @if (product.DiscountPrice.HasValue)
                                {
                                    <span class="text-decoration-line-through text-muted">@product.Price.ToString("C")</span>
                                    <span class="text-danger fw-bold">@product.DiscountPrice?.ToString("C")</span>
                                }
                                else
                                {
                                    <span class="fw-bold">@product.Price.ToString("C")</span>
                                }
                            </td>
                        }
                    </tr>
                    <tr>
                        <td class="fw-bold">Available Sizes</td>
                        @foreach (var product in Model)
                        {
                            var sizes = product.ProductVariants?.Where(v => v.IsAvailable).Select(v => v.Size).Distinct();
                            <td class="text-center">
                                @if (sizes?.Any() == true)
                                {
                                    @string.Join(", ", sizes)
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        }
                    </tr>
                    <tr>
                        <td class="fw-bold">Colors</td>
                        @foreach (var product in Model)
                        {
                            var colors = product.ProductVariants?.Where(v => v.IsAvailable).Select(v => v.Color).Distinct();
                            <td class="text-center">
                                @if (colors?.Any() == true)
                                {
                                    @string.Join(", ", colors)
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                        }
                    </tr>
                    <tr>
                        <td class="fw-bold">Action</td>
                        @foreach (var product in Model)
                        {
                            <td class="text-center">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id" 
                                   class="btn btn-primary btn-sm">View Details</a>
                            </td>
                        }
                    </tr>
                </tbody>
            </table>
        </div>
    }
</div>
