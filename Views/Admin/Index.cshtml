@{
    ViewData["Title"] = "Admin Dashboard";
    var totalOrders = ViewBag.TotalOrders as int? ?? 0;
    var totalRevenue = ViewBag.TotalRevenue as decimal? ?? 0;
}

<h2><i class="bi bi-speedometer2"></i> Admin Dashboard</h2>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <h5><i class="bi bi-bag"></i> Total Orders</h5>
                <h2>@totalOrders</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h5><i class="bi bi-currency-dollar"></i> Total Revenue</h5>
                <h2>@totalRevenue.ToString("C")</h2>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Quick Actions</div>
            <div class="list-group list-group-flush">
                <a asp-action="Users" class="list-group-item list-group-item-action">
                    <i class="bi bi-people"></i> Manage Users
                </a>
                <a asp-controller="Category" asp-action="Index" class="list-group-item list-group-item-action">
                    <i class="bi bi-tags"></i> Manage Categories
                </a>
                <a asp-controller="Product" asp-action="Manage" class="list-group-item list-group-item-action">
                    <i class="bi bi-box-seam"></i> Manage Products
                </a>
                <a asp-controller="Order" asp-action="Manage" class="list-group-item list-group-item-action">
                    <i class="bi bi-bag-check"></i> Manage Orders
                </a>
                <a asp-controller="Review" asp-action="Pending" class="list-group-item list-group-item-action">
                    <i class="bi bi-star"></i> Pending Reviews
                </a>
            </div>
        </div>
    </div>
</div>
