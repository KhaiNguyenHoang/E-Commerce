@using E_Commerce.Services
@inject IAuthService AuthService

@{
    var currentUser = await AuthService.GetCurrentUserAsync();
    var userRole = currentUser?.Role?.Name;
    var isAdmin = userRole == "Admin";
    var isStaff = userRole == "Staff" || userRole == "Admin";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="description" content="ShoeStore - Premium footwear for every occasion"/>
    <title>@ViewData["Title"] - ShoeStore</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Styles -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
</head>
<body>

<!-- Top Bar -->
<div class="bg-dark text-white py-2 d-none d-md-block" style="font-size: 0.85rem;">
    <div class="container d-flex justify-content-between align-items-center">
        <div>
            <i class="bi bi-truck me-1"></i> Free shipping on orders over $100
            <span class="mx-3">|</span>
            <i class="bi bi-telephone me-1"></i> +84 123 456 789
        </div>
        <div>
            <i class="bi bi-envelope me-1"></i> support@shoestore.vn
        </div>
    </div>
</div>

<!-- Main Navbar -->
<header class="sticky-top">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                <span class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-2" 
                      style="width: 40px; height: 40px;">
                    <i class="bi bi-shop"></i>
                </span>
                <span class="fw-bold">ShoeStore</span>
            </a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="mainNav">
                <!-- Main Navigation -->
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link px-3" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-house me-1"></i> Home
                        </a>
                    </li>
                    @if (!isStaff)
                    {
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Product" asp-action="Index">
                                <i class="bi bi-grid me-1"></i> Products
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Compare" asp-action="Index">
                                <i class="bi bi-columns-gap me-1"></i> Compare
                            </a>
                        </li>
                    }
                    
                    @* Staff Menu *@
                    @if (isStaff)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle px-3" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-clipboard-check me-1 text-info"></i>
                                <span class="text-info">Staff</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark">
                                <li class="px-3 py-2 text-muted small text-uppercase">Management</li>
                                <li><a class="dropdown-item" asp-controller="Order" asp-action="Manage">
                                    <i class="bi bi-box-seam me-2"></i>Manage Orders
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Inventory" asp-action="Index">
                                    <i class="bi bi-boxes me-2"></i>Inventory
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Manage">
                                    <i class="bi bi-bag me-2"></i>Products
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Review" asp-action="Pending">
                                    <i class="bi bi-chat-dots me-2"></i>Pending Reviews
                                </a></li>
                            </ul>
                        </li>
                    }
                    
                    @* Admin Menu *@
                    @if (isAdmin)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle px-3" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-shield-lock-fill me-1 text-warning"></i>
                                <span class="text-warning">Admin</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark">
                                <li class="px-3 py-2 text-muted small text-uppercase">Dashboard</li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-2"></i>Dashboard
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Report" asp-action="Index">
                                    <i class="bi bi-graph-up me-2"></i>Reports
                                </a></li>
                                <li><hr class="dropdown-divider border-secondary"></li>
                                <li class="px-3 py-2 text-muted small text-uppercase">Content</li>
                                <li><a class="dropdown-item" asp-controller="Category" asp-action="Index">
                                    <i class="bi bi-tags me-2"></i>Categories
                                </a></li>
                                <li><a class="dropdown-item" asp-controller="Coupon" asp-action="Manage">
                                    <i class="bi bi-ticket-perforated me-2"></i>Coupons
                                </a></li>
                                <li><hr class="dropdown-divider border-secondary"></li>
                                <li class="px-3 py-2 text-muted small text-uppercase">Users</li>
                                <li><a class="dropdown-item" asp-controller="User" asp-action="Index">
                                    <i class="bi bi-people me-2"></i>Manage Users
                                </a></li>
                            </ul>
                        </li>
                    }
                </ul>
                
                <!-- Search Bar -->
                <!-- Search Bar -->
                <form class="d-none d-lg-flex me-3" asp-controller="Product" asp-action="Index" method="get">
                    <div class="input-group">
                        <input type="text" name="search" class="form-control border-0 rounded-start-pill ps-3" 
                               placeholder="Search products..." value="@Context.Request.Query["search"]"
                               aria-label="Search" style="width: 220px;">
                        <button class="btn btn-white bg-white border-0 rounded-end-pill pe-3" type="submit">
                            <i class="bi bi-search text-primary"></i>
                        </button>
                    </div>
                </form>
                
                <!-- User Navigation -->
                <ul class="navbar-nav">
                    @if (currentUser != null)
                    {
                        @if (!isStaff && !isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link px-3 position-relative" asp-controller="Wishlist" asp-action="Index">
                                    <i class="bi bi-heart fs-5"></i>
                                    <span class="visually-hidden">Wishlist</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link px-3 position-relative" asp-controller="Cart" asp-action="Index">
                                    <i class="bi bi-cart3 fs-5"></i>
                                    <span class="visually-hidden">Cart</span>
                                </a>
                            </li>
                        }
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center px-3" href="#" data-bs-toggle="dropdown">
                                @if (!string.IsNullOrEmpty(currentUser.AvatarUrl))
                                {
                                    <img src="@currentUser.AvatarUrl" alt="Avatar" 
                                         class="rounded-circle me-2" style="width:32px;height:32px;object-fit:cover;">
                                }
                                else
                                {
                                    <span class="bg-primary rounded-circle d-flex align-items-center justify-content-center me-2"
                                          style="width:32px;height:32px;">
                                        <i class="bi bi-person text-white"></i>
                                    </span>
                                }
                                <span class="d-none d-lg-inline">@currentUser.FullName</span>
                                @if (isAdmin)
                                {
                                    <span class="badge bg-danger ms-1 d-none d-lg-inline">Admin</span>
                                }
                                else if (userRole == "Staff")
                                {
                                    <span class="badge bg-info ms-1 d-none d-lg-inline">Staff</span>
                                }
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
                                <li class="px-3 py-2">
                                    <div class="fw-bold">@currentUser.FullName</div>
                                    <small class="text-muted">@currentUser.Email</small>
                                </li>
                                <li><hr class="dropdown-divider border-secondary"></li>
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Index">
                                    <i class="bi bi-person me-2"></i>My Profile
                                </a></li>
                                @if (!isStaff && !isAdmin)
                                {
                                    <li><a class="dropdown-item" asp-controller="Order" asp-action="Index">
                                        <i class="bi bi-box-seam me-2"></i>My Orders
                                    </a></li>
                                    <li><a class="dropdown-item" asp-controller="Review" asp-action="MyReviews">
                                        <i class="bi bi-star me-2"></i>My Reviews
                                    </a></li>
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="Addresses">
                                        <i class="bi bi-geo-alt me-2"></i>Addresses
                                    </a></li>
                                }
                                <li><hr class="dropdown-divider border-secondary"></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-2"></i>Logout
                                </a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-controller="Auth" asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-primary btn-sm ms-2" asp-controller="Auth" asp-action="Register">
                                <i class="bi bi-person-plus me-1"></i> Register
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>
</header>

<!-- Main Content -->
<div class="container py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    
    <main role="main">
        @RenderBody()
    </main>
</div>

<!-- Footer -->
<footer class="mt-auto">
    <div class="bg-dark text-light pt-5 pb-4">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-shop me-2"></i>ShoeStore
                    </h5>
                    <p class="text-muted mb-3">
                        Premium footwear for every occasion. Quality shoes, unbeatable prices.
                    </p>
                    <div class="d-flex gap-3">
                        <a href="#" class="text-light fs-4"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-light fs-4"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-light fs-4"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="text-light fs-4"><i class="bi bi-youtube"></i></a>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="fw-bold mb-3">Shop</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a href="#" class="text-muted text-decoration-none">New Arrivals</a></li>
                        <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Best Sellers</a></li>
                        <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Sale</a></li>
                        <li class="mb-2"><a href="#" class="text-muted text-decoration-none">All Products</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="fw-bold mb-3">Help</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a href="#" class="text-muted text-decoration-none">FAQs</a></li>
                        <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Shipping</a></li>
                        <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Returns</a></li>
                        <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Contact</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h6 class="fw-bold mb-3">Newsletter</h6>
                    <p class="text-muted mb-3">Subscribe for exclusive deals and updates.</p>
                    <div class="input-group">
                        <input type="email" class="form-control" placeholder="Your email">
                        <button class="btn btn-primary">Subscribe</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="bg-darker py-3" style="background-color: #111827;">
        <div class="container">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center text-muted small">
                <p class="mb-2 mb-md-0">&copy; 2026 ShoeStore. All rights reserved.</p>
                <div class="d-flex gap-3">
                    <a href="#" class="text-muted text-decoration-none">Privacy Policy</a>
                    <a href="#" class="text-muted text-decoration-none">Terms of Service</a>
                </div>
            </div>
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>