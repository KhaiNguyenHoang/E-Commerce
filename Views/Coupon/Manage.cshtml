@model IEnumerable<E_Commerce.Models.Coupon>
@{
    ViewData["Title"] = "Coupons";
    Layout = "_AdminLayout";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-ticket-perforated me-2"></i>Manage Coupons</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Create Coupon
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Code</th>
                        <th>Discount</th>
                        <th>Valid Period</th>
                        <th>Usage</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var coupon in Model)
                    {
                        var isExpired = DateTime.UtcNow > coupon.EndDate;
                        var isNotStarted = DateTime.UtcNow < coupon.StartDate;
                        <tr>
                            <td>
                                <span class="badge bg-dark font-monospace fs-6">@coupon.Code</span>
                                @if (!string.IsNullOrEmpty(coupon.Description))
                                {
                                    <small class="d-block text-muted">@coupon.Description</small>
                                }
                            </td>
                            <td>
                                @if (coupon.DiscountType == E_Commerce.Models.DiscountType.Percentage)
                                {
                                    <span class="text-success fw-bold">@coupon.DiscountValue%</span>
                                }
                                else
                                {
                                    <span class="text-success fw-bold">@coupon.DiscountValue.ToString("C")</span>
                                }
                                @if (coupon.MaximumDiscountAmount.HasValue)
                                {
                                    <small class="d-block text-muted">Max: @coupon.MaximumDiscountAmount?.ToString("C")</small>
                                }
                            </td>
                            <td>
                                <small>@coupon.StartDate.ToString("dd/MM/yyyy")</small>
                                <small>-</small>
                                <small>@coupon.EndDate.ToString("dd/MM/yyyy")</small>
                            </td>
                            <td>
                                @coupon.UsedCount / @(coupon.UsageLimit?.ToString() ?? "∞")
                            </td>
                            <td>
                                @if (!coupon.IsActive)
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                                else if (isExpired)
                                {
                                    <span class="badge bg-danger">Expired</span>
                                }
                                else if (isNotStarted)
                                {
                                    <span class="badge bg-warning">Scheduled</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@coupon.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@coupon.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Delete this coupon?')">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">No coupons found</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
