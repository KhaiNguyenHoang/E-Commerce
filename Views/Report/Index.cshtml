@model E_Commerce.DTOs.Report.DashboardSummaryDto
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<div class="row mb-4">
    <div class="col-md-3">
        <div class="stat-card primary text-white bg-primary bg-gradient border-0">
            <div class="d-flex align-items-center">
                <div class="stat-icon bg-white bg-opacity-25 text-white rounded-3 me-3">
                    <i class="bi bi-currency-dollar"></i>
                </div>
                <div>
                    <h6 class="mb-0 opacity-75">Total Revenue</h6>
                    <h3 class="mb-0 fw-bold">@Model.TotalRevenue.ToString("C")</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card success text-white bg-success bg-gradient border-0">
            <div class="d-flex align-items-center">
                <div class="stat-icon bg-white bg-opacity-25 text-white rounded-3 me-3">
                    <i class="bi bi-bag-check"></i>
                </div>
                <div>
                    <h6 class="mb-0 opacity-75">Total Orders</h6>
                    <h3 class="mb-0 fw-bold">@Model.TotalOrders</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card warning text-dark bg-warning bg-gradient border-0">
            <div class="d-flex align-items-center">
                <div class="stat-icon bg-white bg-opacity-25 text-dark rounded-3 me-3">
                     <i class="bi bi-people"></i>
                </div>
                <div>
                    <h6 class="mb-0 opacity-75">Total Users</h6>
                    <h3 class="mb-0 fw-bold">@Model.TotalUsers</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card info text-white bg-info bg-gradient border-0">
            <div class="d-flex align-items-center">
                <div class="stat-icon bg-white bg-opacity-25 text-white rounded-3 me-3">
                    <i class="bi bi-cart"></i>
                </div>
                <div>
                    <h6 class="mb-0 opacity-75">Avg Order Value</h6>
                    <h3 class="mb-0 fw-bold">@Model.AverageOrderValue.ToString("C")</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">Revenue Overview</h5>
                <select id="revenueRange" class="form-select form-select-sm w-auto">
                    <option value="30">Last 30 Days</option>
                    <option value="7">Last 7 Days</option>
                </select>
            </div>
            <div class="card-body">
                <canvas id="revenueChart" style="height: 300px; width: 100%;"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Order Status</h5>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <div style="height: 250px; width: 250px;">
                    <canvas id="orderStatusChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">Recent Orders</h5>
                <a asp-controller="Order" asp-action="Manage" class="btn btn-sm btn-outline-primary">View All</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table align-middle mb-0 table-hover">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Order ID</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th>Total</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">#@order.OrderNumber</td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-secondary bg-opacity-10 rounded-circle text-center d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px;">
                                                <i class="bi bi-person text-secondary"></i>
                                            </div>
                                            <span>@order.ShippingName</span>
                                        </div>
                                    </td>
                                    <td>@order.CreatedAt.ToString("MMM dd, HH:mm")</td>
                                    <td>@order.TotalAmount.ToString("C")</td>
                                    <td>
                                        @switch (order.Status)
                                        {
                                            case E_Commerce.Models.OrderStatus.Pending:
                                                <span class="badge bg-warning text-dark rounded-pill">Pending</span>
                                                break;
                                            case E_Commerce.Models.OrderStatus.Confirmed:
                                                <span class="badge bg-info text-white rounded-pill">Confirmed</span>
                                                break;
                                            case E_Commerce.Models.OrderStatus.Delivered:
                                                <span class="badge bg-success rounded-pill">Delivered</span>
                                                break;
                                            case E_Commerce.Models.OrderStatus.Cancelled:
                                                <span class="badge bg-danger rounded-pill">Cancelled</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary rounded-pill">@order.Status</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-light text-primary">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Top Selling Products</h5>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    @foreach (var product in Model.TopProducts)
                    {
                        <div class="list-group-item px-4 py-3 d-flex align-items-center border-bottom-0">
                            <div class="bg-primary bg-opacity-10 rounded text-primary fw-bold d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                @product.QuantitySold
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-0 text-truncate" style="max-width: 200px;">@product.ProductName</h6>
                                <small class="text-muted">Revenue: @product.TotalRevenue.ToString("C")</small>
                            </div>
                        </div>
                    }
                    @if (!Model.TopProducts.Any())
                    {
                        <div class="p-4 text-center text-muted">No sales data yet.</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Data from server
        const revenueData = @Html.Raw(Json.Serialize(Model.RevenueStats));
        const orderStatusData = @Html.Raw(Json.Serialize(Model.OrderStatusStats));

        // Format dates
        const revenueLabels = revenueData.map(d => {
            const date = new Date(d.date);
            return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        });
        const revenueValues = revenueData.map(d => d.revenue);

        // Revenue Chart
        const ctxRevenue = document.getElementById('revenueChart').getContext('2d');
        const revenueChart = new Chart(ctxRevenue, {
            type: 'line',
            data: {
                labels: revenueLabels,
                datasets: [{
                    label: 'Revenue',
                    data: revenueValues,
                    borderColor: '#0d6efd',
                    backgroundColor: 'rgba(13, 110, 253, 0.1)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.4,
                    pointRadius: 4,
                    pointHoverRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { borderDash: [2, 4] }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });

        // Order Status Chart
        const ctxStatus = document.getElementById('orderStatusChart').getContext('2d');
        const statusLabels = orderStatusData.map(d => d.status);
        const statusValues = orderStatusData.map(d => d.count);
        const statusColors = ['#ffc107', '#0dcaf0', '#0d6efd', '#6610f2', '#198754', '#dc3545', '#6c757d'];

        new Chart(ctxStatus, {
            type: 'doughnut',
            data: {
                labels: statusLabels,
                datasets: [{
                    data: statusValues,
                    backgroundColor: statusColors,
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { usePointStyle: true, padding: 20 } }
                }
            }
        });
    </script>
}
