@model IEnumerable<E_Commerce.Models.Review>
@{
    ViewData["Title"] = "My Reviews";
}

<h2><i class="bi bi-star"></i> My Reviews</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">You haven't written any reviews yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Product</th>
                    <th>Rating</th>
                    <th>Comment</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var review in Model)
                {
                    <tr>
                        <td>@review.Product?.Name</td>
                        <td class="text-warning">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="bi bi-star@(i <= review.Rating ? "-fill" : "")"></i>
                            }
                        </td>
                        <td>@(review.Comment?.Length > 50 ? review.Comment.Substring(0, 50) + "..." : review.Comment)</td>
                        <td>
                            @if (review.IsApproved)
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                        </td>
                        <td>@review.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@review.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@review.Id" method="post" class="d-inline" onsubmit="return confirm('Delete?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
